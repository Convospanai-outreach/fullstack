# ============================================
# ConvoSpan - Environment Variables
# ============================================


# -------------------- Database --------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/convospan

# Prisma Engine (Recommended for Vercel)
PRISMA_CLIENT_ENGINE_TYPE=binary

# -------------------- Authentication --------------------
# NextAuth secret key (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here

# Application URL (update for production)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional - for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------- Payment Gateway --------------------
# Razorpay credentials (get from https://dashboard.razorpay.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# -------------------- Email Service --------------------
# Email sender details
SMTP_FROM_NAME=ConvoSpan
SMTP_FROM_EMAIL=noreply@convospan.com

# SendPulse API credentials (configure in SendPulse dashboard)
# Note: SendPulse integration is already set up in the codebase

# Alternative: Resend (if you prefer)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Alternative: SendGrid (if you prefer)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Alternative: SMTP (Gmail, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# -------------------- AI Services --------------------
# Multi-Provider LLM Configuration
# You can configure multiple providers for automatic fallback and cost optimization
# The system will intelligently route requests based on task complexity and provider availability

# OpenAI (GPT-4o for strategic tasks, GPT-4o-mini for routine)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Google Gemini (Gemini 1.5 Pro for strategic, Flash for routine - fast & affordable)
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxx
# Alternative key name (either works):
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxx

# Groq (Ultra-fast Llama 3.1 - recommended for routine tasks, very cheap)
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# Anthropic Claude (Claude 3.5 Sonnet for strategic, Haiku for fast tasks)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Recommended: Configure at least 2 providers for redundancy
# Ideal setup for cost optimization: GROQ_API_KEY + GOOGLE_API_KEY + OPENAI_API_KEY

# -------------------- Cache & Queue (Optional) --------------------
# Redis for LLM response caching and job queues (recommended for production)
# REDIS_URL=redis://localhost:6379
# Or Upstash Redis (serverless):
# REDIS_URL=rediss://default:xxxxx@region.upstash.io:6379


# -------------------- Optional: CORS --------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# -------------------- Optional: Monitoring --------------------
# Sentry (for error tracking)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Posthog (for product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -------------------- Optional: CRM Integrations --------------------
# HubSpot
# HUBSPOT_API_KEY=your-hubspot-api-key

# Salesforce
# SALESFORCE_CLIENT_ID=your-salesforce-client-id
# SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret

# -------------------- Development --------------------
# Node environment
NODE_ENV=development

# Enable debug logging (optional)
# DEBUG=true
