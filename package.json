{
  "name": "convospan-platform",
  "private": true,
  "description": "ConvoSpan monorepo orchestration root",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "typecheck:api": "npm run typecheck --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "start:web": "npm run start --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "docker:api": "docker build -t convospan-api:latest -f apps/api/Dockerfile apps/api",
    "docker:edge": "docker build -t convospan-edge-fastapi:latest -f apps/edge-fastapi/Dockerfile apps/edge-fastapi"
  }
}
