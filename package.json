{
  "name": "craftmyfunnel-platform",
  "private": true,
  "description": "CraftMyFunnel monorepo orchestration root",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "typecheck:api": "npm run typecheck --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "start:web": "npm run start --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "preflight:runtime-files": "node scripts/check-critical-runtime-files.mjs",
    "beta:start": "node scripts/start-local-beta.mjs",
    "beta:start:all": "node scripts/start-local-beta.mjs --with-edge",
    "docker:web": "docker build -t craftmyfunnel-web:latest -f apps/web/Dockerfile .",
    "docker:api": "docker build -t craftmyfunnel-api:latest -f apps/api/Dockerfile .",
    "docker:edge": "docker build -t craftmyfunnel-edge-fastapi:latest -f apps/edge-fastapi/Dockerfile apps/edge-fastapi",
    "docker:edge:pi5": "docker buildx build --platform linux/arm64 --build-arg REQUIREMENTS_FILE=requirements.pi.txt --build-arg FORCE_CMAKE=1 --build-arg CMAKE_ARGS=\"-DGGML_NATIVE=OFF -DGGML_OPENMP=ON\" -t craftmyfunnel-edge-fastapi:pi5 -f apps/edge-fastapi/Dockerfile apps/edge-fastapi",
    "verify:before-push": "node scripts/check-web-prisma-imports.mjs && node scripts/check-web-route-db-imports.mjs && node scripts/check-web-auth-mode.mjs && npm --workspace apps/web run build",
    "schema:verify:readonly": "node scripts/db/verify-schema-readiness.mjs",
    "schema:verify:production": "node scripts/db/verify-schema-readiness.mjs --production",
    "db:schema:compare": "node scripts/db/compare-prisma-schemas.mjs",
    "readiness:audit:no-seed": "node scripts/readiness/no-seed-readiness-audit.mjs",
    "readiness:check-db-shape": "npx tsx scripts/readiness/check-db-shape.ts",
    "readiness:check-migration-status": "npx tsx scripts/readiness/check-migration-status.ts",
    "migrations:scan:destructive": "node --experimental-strip-types scripts/readiness/scan-destructive-migrations.ts"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.34",
    "form-data": "^4.0.6",
    "fastify": "^5.8.5",
    "nodemailer": "^9.0.1",
    "next": "16.2.11",
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "uuid": "14.0.1",
    "geoip-lite": "1.4.10",
    "ws": "8.21.0",
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "ip-address": "10.4.0",
    "socket.io-parser": "4.2.7",
    "valibot": "1.4.2",
    "sharp": "0.35.3",
    "axios": "^1.7.4",
    "cross-spawn": "^7.0.5",
    "nanoid": "^3.3.8",
    "node-notifier": "^10.0.1",
    "picomatch": "^4.0.4",
    "js-yaml": "4.3.1",
    "@babel/core": "7.29.7",
    "@opentelemetry/core": "2.9.0",
    "dompurify": "3.4.13",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@rolldown/binding-wasm32-wasi": {
      "@emnapi/core": "1.11.1",
      "@emnapi/runtime": "1.11.1"
    },
    "@unrs/resolver-binding-wasm32-wasi": {
      "@emnapi/core": "1.11.1",
      "@emnapi/runtime": "1.11.1"
    }
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@vitest/coverage-v8": "^4.1.8"
  }
}
