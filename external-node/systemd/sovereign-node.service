[Unit]
Description=ConvoSpan Sovereign Node & Micro-LLM
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/external-node
Environment="PATH=/home/pi/external-node/venv/bin"
EnvironmentFile=/home/pi/external-node/.env
ExecStart=/home/pi/external-node/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8081

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
