// --- ENTERPRISE MICRO-LLM TRAINING INFRASTRUCTURE ---

enum TrainingTaskType {
  TONE_NORMALIZATION
  GRAMMAR_REPAIR
  BRAND_ENFORCEMENT
  POLICY_CLASSIFICATION
  POLICY_REWRITE
  CONVERSATION_SUMMARY
  OBJECTION_EXTRACTION
  REFUSAL_GENERATION
}

enum DatasetStatus {
  DRAFT
  IN_REVIEW
  REVIEWED
  TRAINING
  DEPLOYED
}

enum ModelStatus {
  TRAINING
  VALIDATION
  DEPLOYED
  ROLLED_BACK
  DEPRECATED
}

model TrainingDataset {
  id            String   @id @default(uuid())
  version       String   @unique
  taskType      TrainingTaskType
  recordCount   Int      @default(0)
  datasetHash   String
  configHash    String
  status        DatasetStatus @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  records       TrainingRecord[]
  reviews       DatasetReview[]
  modelVersions ModelVersion[]
  
  @@index([status])
  @@index([taskType])
}

model TrainingRecord {
  id                  String   @id @default(uuid())
  datasetId           String
  taskType            TrainingTaskType
  inputText           String   @db.Text
  brandRules          Json
  policyRules         Json
  expectedOutput      String   @db.Text
  rejectionConditions Json
  reviewScore         Float?
  reviewedBy          String?
  reviewedAt          DateTime?
  approved            Boolean  @default(false)
  createdAt           DateTime @default(now())
  
  dataset             TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  
  @@index([datasetId])
  @@index([approved])
  @@index([reviewScore])
}

model DatasetReview {
  id                String   @id @default(uuid())
  datasetId         String
  reviewerId        String
  sampleSize        Int
  avgScore          Float
  policyCorrectness Float
  toneQuality       Float
  clarity           Float
  realism           Float
  refusalQuality    Float?
  notes             String?  @db.Text
  approved          Boolean
  createdAt         DateTime @default(now())
  
  dataset   TrainingDataset @relation(fields: [datasetId], references: [id])
  reviewer  User            @relation(fields: [reviewerId], references: [id])
  
  @@index([datasetId])
  @@index([reviewerId])
}

model ModelVersion {
  id                  String   @id @default(uuid())
  version             String   @unique
  baseModel           String
  datasetId           String
  configHash          String
  changelog           String   @db.Text
  status              ModelStatus @default(TRAINING)
  refusalAccuracy     Float?
  policyViolationRate Float?
  driftScore          Float?
  verbosityScore      Float?
  deployedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  dataset             TrainingDataset @relation(fields: [datasetId], references: [id])
  metrics             EvaluationMetric[]
  
  @@index([status])
  @@index([version])
}

model EvaluationMetric {
  id              String   @id @default(uuid())
  modelVersionId  String
  metricType      String   // REFUSAL_ACC, POLICY_VIOLATION, DRIFT, VERBOSITY
  value           Float
  threshold       Float
  passed          Boolean
  metadata        Json?
  timestamp       DateTime @default(now())
  
  modelVersion    ModelVersion @relation(fields: [modelVersionId], references: [id])
  
  @@index([modelVersionId])
  @@index([metricType])
  @@index([passed])
}

// --- END ML TRAINING INFRASTRUCTURE ---

// --- CLIENT ERROR LOGGING ---

model ClientError {
  id             String   @id @default(uuid())
  message        String   @db.VarChar(500)
  stack          String?  @db.Text
  componentStack String?  @db.Text
  url            String
  userAgent      String
  userId         String?
  ip             String
  metadata       Json?
  createdAt      DateTime @default(now())
  
  @@index([createdAt])
  @@index([userId])
  @@index([url])
}

// --- REPLY DECISION TREE TRACKER ---

model ReplyTracker {
  id              String   @id @default(uuid())
  leadId          String
  emailId         String?  // Original outbound email ID if available
  receivedAt      DateTime @default(now())
  
  senderEmail     String
  subject         String
  body            String   @db.Text
  
  // AI Classification
  aiClassification String  // INTERESTED, NOT_INTERESTED, OOO, QUESTION, DNC
  aiConfidence     Float   // 0.0 - 1.0 confidence score
  aiReasoning      String? @db.Text
  sentimentScore   Float?  // -1.0 to 1.0
  
  // HITL State
  status          String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, AUTO_HANDLED
  humanCorrection String?  // Stores correct classification if AI was wrong
  reviewedBy      String?  // User ID of operator
  reviewedAt      DateTime?
  
  // Action taken
  actionTaken     String?  // PAUSED_CAMPAIGN, SENT_REPLY, SCHEDULED_MEETING
  replyDraft      String?  @db.Text // The AI suggested reply
  
  lead            Lead     @relation(fields: [leadId], references: [id])
  
  @@index([status])
  @@index([leadId])
  @@index([aiClassification])
}

model CalendarEvent {
  id             String      @id @default(cuid())
  eventName      String
  eventDate      DateTime
  category       String
  leadGenAngle   String
  newsletterId   String?     @unique
  newsletter     Newsletter? @relation(fields: [newsletterId], references: [id])

  @@unique([eventName, eventDate])
}

model Newsletter {
  id             String         @id @default(cuid())
  subjectLine    String
  emailBodyHtml  String
  cta            String
  event          CalendarEvent?
}

model ShadowSignal {
  id            String   @id @default(uuid())
  source        String   // "reddit", "glassdoor", etc.
  url           String
  content       String   @db.Text
  frictionScore Float
  detectedICPs  String[]
  isWarmLead    Boolean  @default(false)
  metadata      Json?
  
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])
  
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id])
  
  createdAt     DateTime @default(now())

  @@index([teamId])
  @@index([leadId])
  @@index([source])
  @@index([isWarmLead])
}

// Foundation Models for RAG and Analytics
model VectorDocument {
  id        String   @id @default(uuid())
  type      String
  content   String   @db.Text
  metadata  String?  @db.Text // JSON string
  embedding String?  @db.Text // JSON string
  created_at DateTime @default(now())

  @@index([type])
}

model EngagementLog {
  id        String   @id @default(uuid())
  email     String
  event     String
  context   String?  @db.Text
  result    String?  @db.Text // JSON string
  createdAt DateTime @default(now())

  @@index([email])
  @@index([event])
}

