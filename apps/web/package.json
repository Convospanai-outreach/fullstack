{
    "name": "craftmyfunnel-full-scaffold",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/craftmyfunnel-outreach/fullstack.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "repair:vendor": "node scripts/repair-package-exports.mjs",
        "postinstall": "npm run repair:vendor",
        "dev": "npm run repair:vendor && node scripts/run-with-app-env.mjs ../../node_modules/next/dist/bin/next dev --webpack",
        "prebuild": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- npx prisma generate --schema prisma/schema.prisma",
        "build": "node scripts/clean-next-lock.mjs && npm run repair:vendor && node scripts/run-with-env.mjs PRISMA_CLIENT_ENGINE_TYPE=client NODE_OPTIONS=--max-old-space-size=8192 -- node scripts/build-next-with-retry.mjs",
        "start": "npm run repair:vendor && node scripts/run-with-app-env.mjs scripts/start-production.mjs",
        "lint": "node scripts/lint.mjs",
        "typecheck": "node scripts/run-with-env.mjs NODE_OPTIONS=--max-old-space-size=8192 -- tsc --noEmit",
        "worker": "node scripts/run-with-env.mjs PRISMA_CLIENT_ENGINE_TYPE=client -- tsx -r dotenv/config src/workers/index.ts",
        "test": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- vitest",
        "test:ui": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- vitest --ui",
        "test:coverage": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- vitest run tests/unit --coverage",
        "test:unit": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- vitest run tests/unit",
        "test:integration": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- vitest run tests/integration",
        "test:e2e": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp -- playwright test",
        "db:generate": "node scripts/run-with-env.mjs PRISMA_CLIENT_ENGINE_TYPE=client NODE_OPTIONS=--max-old-space-size=8192 -- prisma generate",
        "readiness:seed": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp PRISMA_CLIENT_ENGINE_TYPE=client -- tsx -r dotenv/config src/scripts/seed-readiness.ts",
        "readiness:audit": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp PRISMA_CLIENT_ENGINE_TYPE=client -- tsx -r dotenv/config src/scripts/validate-production-readiness.ts",
        "db:archive": "node scripts/run-with-env.mjs TEMP=./tmp TMP=./tmp PRISMA_CLIENT_ENGINE_TYPE=client -- tsx -r dotenv/config src/scripts/archive-audit-logs.ts"
    },
    "devDependencies": {
        "@emnapi/core": "1.11.1",
        "@emnapi/runtime": "1.11.1",
        "@eslint/eslintrc": "^3.3.5",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4.1.17",
        "@types/nodemailer": "^7.0.11",
        "@types/papaparse": "^5.5.0",
        "@types/react": "19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^4.1.8",
        "@vitest/ui": "^4.1.8",
        "autoprefixer": "^10.4.22",
        "dotenv": "^17.2.3",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.1.6",
        "jsdom": "^27.4.0",
        "postcss": "^8.5.15",
        "prisma": "7.8.0",
        "server-only": "^0.0.1",
        "tailwindcss": "^4.1.17",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.21.0",
        "typescript": "5.9.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.8"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@clerk/nextjs": "^7.4.3",
        "@gsap/react": "^2.1.2",
        "@hubspot/api-client": "^13.4.0",
        "@next-auth/prisma-adapter": "^1.0.7",
        "@opentelemetry/core": "^2.9.0",
        "@opentelemetry/resources": "^2.9.0",
        "@opentelemetry/sdk-trace-base": "^2.9.0",
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "7.8.0",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.4.2",
        "@sentry/nextjs": "^10.32.1",
        "@types/three": "^0.182.0",
        "axios": "^1.18.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cron-parser": "^5.4.0",
        "date-fns": "^4.1.0",
        "dexie": "^4.0.1",
        "dexie-react-hooks": "^4.2.0",
        "eventsource": "^4.1.0",
        "framer-motion": "^12.23.26",
        "geoip-lite": "^2.0.2",
        "grapesjs": "^0.23.2",
        "gsap": "^3.15.0",
        "ioredis": "^5.9.1",
        "lenis": "^1.3.23",
        "lru-cache": "^11.2.4",
        "lucide-react": "^0.556.0",
        "next": "^16.2.7",
        "next-auth": "^4.24.14",
        "nodemailer": "^9.0.1",
        "papaparse": "^5.5.3",
        "pg": "^8.20.0",
        "posthog-js": "^1.286.0",
        "pptxgenjs": "^4.0.1",
        "prom-client": "^15.1.3",
        "qs": "^6.15.2",
        "razorpay": "^2.9.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-error-boundary": "^6.0.0",
        "react-is": "^19.2.0",
        "react-markdown": "^10.1.0",
        "reactflow": "^11.11.4",
        "recharts": "^3.5.1",
        "redis": "^5.10.0",
        "socket.io": "^4.8.1",
        "sonner": "^2.0.7",
        "swr": "^2.3.7",
        "tailwind-merge": "^3.4.0",
        "three": "^0.182.0",
        "uuid": "^14.0.0",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "4.1.17",
        "@tailwindcss/oxide-linux-x64-musl": "4.1.17",
        "lightningcss-linux-x64-gnu": "1.30.2",
        "lightningcss-linux-x64-musl": "1.30.2"
    },
    "overrides": {
        "@emnapi/core": "1.11.1",
        "@emnapi/runtime": "1.11.1"
    }
}
