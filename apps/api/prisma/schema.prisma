}

model CustomDomain {
  id        String   @id @default(uuid())
  domain    String   @unique
  teamId    String
  status    String   @default("pending") // pending, active, invalid
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model OrganizationPolicy {
