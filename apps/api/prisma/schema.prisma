  @@index([teamId, eventType])
  @@index([aggregateType, aggregateId])
}

model BlindIndex {
  id         String   @id @default(uuid())
  teamId     String
  entityType String
  entityId   String
  fieldName  String
  indexHash  String
  createdAt  DateTime @default(now())

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, entityType, entityId, fieldName])
  @@index([teamId, entityType, fieldName, indexHash])
}
