generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  GLOBAL
  UAE
  EU
}

model Lead {
  id         String   @id @default(uuid())
  fullName   String?
  email      String?
  phone      String? // <-- Added field for Audit Remediation
  linkedIn   String?
  company    String?
  jobTitle   String?
  location   String?
  status     String   @default("NEW")
  source     String?
  priority   String?
  tags       String[]
  isEnriched Boolean  @default(false)

  // Data Sharding & Market Context
  regionId      Region @default(GLOBAL)
  marketContext Json? // Stores { detectedCountry: "AE", frictionScore: 0.8 }

  enrichedData Json?
  embedding    String? // Controlled-beta canonical type: String/text (matches live DB). Vector(1536) upgrade is a future migration phase.
  value        Float?    @default(0.0) // Potential Deal Value
  wonAt        DateTime? // When it was marked CLOSED_WON
  lostAt       DateTime? // When it was marked CLOSED_LOST
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  campaignId   String?
  teamId       String?

  // CRM Sync
  crmId       String? // External ID in HubSpot/Salesforce
  crmSyncedAt DateTime?

  // Lead Intent Scoring (Weighted Algorithm)
  intentScore      Float?    @default(0.0) // 0.0 - 1.0 weighted intent score
  leadScore        Int       @default(0) // Integer score based on successful generations
  dwellTimeMinutes Float?    @default(0.0) // Website dwell time in minutes
  emailClicks      Int?      @default(0) // Email click count
  socialMentions   Int?      @default(0) // Social media mention count
  lastScoredAt     DateTime? // When intent was last calculated

  // Predictive Analytics
  clusterLabel    String? // HIGH_VALUE, AT_RISK, NEW, DORMANT (from K-means)
  churnRisk       Float? // 0.0 - 1.0 churn probability
  optimalSendHour Int? // 0-23 optimal email send hour

  // DPDP Act 2023 Compliance
  consentObtained Boolean @default(false)

  emails              Email[]
  emailEvents         EmailEvent[]
  suppressionEntries  SuppressionEntry[]
  trackedLinks        TrackedLink[]
  sequenceEnrollments SequenceEnrollment[]
  sequenceStepRuns    SequenceStepRun[]
  campaign            Campaign?            @relation(fields: [campaignId], references: [id])
  team                Team?                @relation(fields: [teamId], references: [id])
  meetings            Meeting[]
  messages            Message[]
  tasks               Task[]
  generations         Generation[]

  // Pipeline State (COLD â†’ WARM â†’ HOT â†’ COORDINATING â†’ MEETING_CONFIRMED â†’ COMPLETED)
  pipelineState          String    @default("COLD")
  pipelineStateChangedAt DateTime?
  hotAt                  DateTime? // When lead became HOT

  // WhatsApp Consent & Contact
  whatsappConsent   Boolean   @default(false)
  whatsappConsentAt DateTime?
  whatsappConsentBy String? // User who recorded consent
  whatsappNumber    String?

  // Meeting Preferences  
  preferredMeetingType String? // virtual, in_person
  meetingLocation      String?

  // Conversation Thread
  conversationEntries ConversationEntry[]
  threads             ConversationThread[] // Added for Conversation System Spine
  coordinationQueue   MeetingCoordinationQueue?
  whatsappMessages    WhatsAppMessage[]
  consentLedger       ConsentLedger[]
  replies             ReplyTracker[]
  shadowSignals       ShadowSignal[]
  channelStatuses     LeadChannelStatus[]
  leadActivities      LeadActivity[]

  @@index([teamId])
  @@index([email])
  @@index([company])
  @@index([status])
  @@index([intentScore])
  @@index([leadScore])
  @@index([pipelineState])
  // Optimization for dashboard filters
  @@index([teamId, status])
  @@index([teamId, pipelineState])
  @@index([teamId, email]) // For faster duplicate checks
}

model LeadChannelStatus {
  id             String   @id @default(uuid())
  leadId         String
  channel        String
  status         String   @default("NOT_STARTED")
  lastActivityAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, channel])
  @@index([channel, status])
  @@index([lastActivityAt])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  channel   String
  type      String
  title     String
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())
  createdBy String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([channel, type])
  @@index([createdBy])
}

model Generation {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id])
  promptPayload   Json // Store the specific traits used (e.g., industry, pain point)
  generatedText   String
  status          String   @default("PENDING") // SENT, CLICKED, REPLIED
  conversionValue Float    @default(0.0)
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([status])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("TODO") // TODO, DONE
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  leadId      String?
  userId      String
  teamId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id])
  team Team  @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([userId])
  @@index([leadId])
  @@index([status])
}

model Campaign {
  id                  String               @id @default(uuid())
  name                String
  description         String?
  audience            String?
  status              String               @default("draft")
  type                String               @default("standard") // standard, smart
  aiConfig            Json? // Stores { tone, goal, context, prompt }
  targetCount         Int                  @default(0)
  completedCount      Int                  @default(0)
  leads               Int                  @default(0) // User requested Int field for count
  consecutiveFailures Int                  @default(0) // Track sequential job failures
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  teamId              String?
  ownerId             String?
  team                Team?                @relation(fields: [teamId], references: [id])
  owner               User?                @relation("owner_campaigns", fields: [ownerId], references: [id])
  variants            CampaignVariant[]
  emails              Email[]
  sequences           CampaignSequence[]
  sequenceEnrollments SequenceEnrollment[]
  sequenceStepRuns    SequenceStepRun[]
  trackedLinks        TrackedLink[]

  scheduledStart DateTime? // <-- Added field

  // Relations
  leadList            Lead[] // Renamed relation to avoid conflict with 'leads' Int
  campaignEmailEvents EmailEvent[]

  activities           Activity[]
  landingCampaignLinks LandingCampaign[] @relation("LandingCampaignLinkedCampaign")

  @@index([status])
  @@index([teamId])
  @@index([createdAt])
  // Optimization for multi-tenant campaign lists
  @@index([teamId, status])
}

model CampaignVariant {
  id         String   @id @default(uuid())
  campaignId String
  subject    String
  body       String
  weight     Int      @default(50)
  sentCount  Int      @default(0)
  openCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model LandingCampaign {
  id                  String                   @id @default(uuid())
  teamId              String
  ownerId             String?
  linkedCampaignId    String?
  name                String
  prompt              String                   @db.Text
  framework           String?
  challenge           String?                  @db.Text
  solution            String?                  @db.Text
  benefit             String?                  @db.Text
  selectedWireframeId String?
  status              String                   @default("draft")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  team                Team                     @relation(fields: [teamId], references: [id])
  owner               User?                    @relation("LandingCampaignOwner", fields: [ownerId], references: [id])
  linkedCampaign      Campaign?                @relation("LandingCampaignLinkedCampaign", fields: [linkedCampaignId], references: [id])
  assets              LandingAsset[]
  wireframeOptions    LandingWireframeOption[]
  pages               LandingPage[]
  leads               LandingLead[]
  events              LandingEvent[]

  @@index([teamId])
  @@index([status])
  @@index([createdAt])
  @@index([linkedCampaignId])
}

model LandingAsset {
  id         String          @id @default(uuid())
  campaignId String
  type       String
  sourceName String?
  content    String          @db.Text
  metadata   Json?
  createdAt  DateTime        @default(now())
  campaign   LandingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

model LandingWireframeOption {
  id          String          @id @default(uuid())
  campaignId  String
  title       String
  description String?
  framework   String
  score       Int             @default(0)
  structure   Json
  createdAt   DateTime        @default(now())
  campaign    LandingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

model LandingPage {
  id           String          @id @default(uuid())
  campaignId   String
  teamId       String
  slug         String          @unique
  title        String?
  status       String          @default("draft")
  version      Int             @default(1)
  editorState  Json?
  renderedJson Json
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaign     LandingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team         Team            @relation(fields: [teamId], references: [id])
  leads        LandingLead[]
  events       LandingEvent[]

  @@index([campaignId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
}

model LandingLead {
  id            String          @id @default(uuid())
  landingPageId String
  campaignId    String
  teamId        String
  sessionId     String?
  pageVersion   Int?
  name          String?
  email         String?
  phone         String?
  company       String?
  title         String?
  rawPayload    Json?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  referrer      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())
  landingPage   LandingPage     @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  campaign      LandingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team          Team            @relation(fields: [teamId], references: [id])

  @@index([landingPageId])
  @@index([campaignId])
  @@index([teamId, createdAt])
  @@index([email])
}

model LandingEvent {
  id            String          @id @default(uuid())
  landingPageId String
  campaignId    String
  teamId        String
  sessionId     String?
  eventName     String
  eventData     Json?
  pageVersion   Int?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())
  landingPage   LandingPage     @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  campaign      LandingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team          Team            @relation(fields: [teamId], references: [id])

  @@index([landingPageId])
  @@index([campaignId])
  @@index([teamId, createdAt])
  @@index([eventName])
}

model Activity {
  id         String    @id @default(uuid())
  type       String
  message    String?
  meta       Json?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  agentId    String?
}

model Agent {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("idle")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ICP {
  id          String   @id @default(uuid())
  teamId      String
  name        String
  description String?
  criteria    Json
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([status])
}

// A tenant's connected Stripe (Connect, Standard/OAuth) or Razorpay (Route,
// linked account) account. Funnel checkout money settles into this account,
// not a CraftMyFunnel platform account - see OPEN-52.
model PaymentAccount {
  id                String   @id @default(cuid())
  teamId            String
  gateway           String // "STRIPE" | "RAZORPAY"
  status            String   @default("PENDING") // PENDING | ACTIVE | DISABLED
  externalAccountId String? // Stripe connected account id ("acct_...") / Razorpay linked account id ("acc_...")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, gateway])
}

model Product {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  priceAmount Int // smallest currency unit (e.g. cents / paise)
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team   Team    @relation(fields: [teamId], references: [id])
  orders Order[]

  @@index([teamId])
}

model Order {
  id               String   @id @default(cuid())
  teamId           String
  productId        String
  gateway          String // "STRIPE" | "RAZORPAY"
  gatewayAccountId String? // the PaymentAccount.externalAccountId funds were routed to
  gatewaySessionId String? // Stripe Checkout Session id / Razorpay order id
  gatewayPaymentId String? // Stripe PaymentIntent id / Razorpay payment id
  customerEmail    String?
  customerName     String?
  amount           Int
  currency         String
  status           String   @default("PENDING") // PENDING | CAPTURED | FAILED | REFUNDED
  landingPageSlug  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  team    Team    @relation(fields: [teamId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([gateway, gatewayPaymentId])
  @@index([teamId])
  @@index([productId])
}

model Job {
  id             String    @id @default(uuid())
  type           String
  status         String    @default("queued")
  priority       Int       @default(0)
  payload        Json
  result         Json?
  error          String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  processAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  teamId         String?
  team           Team?     @relation(fields: [teamId], references: [id])
  idempotencyKey String?   @unique
  version        Int?      @default(1)
  taskType       String?
  executionMode  String?
  targetRuntime  String?
  taskId         String?
  tenantId       String?
  correlationId  String?
  expiresAt      DateTime?
  policy         Json?
  auditContext   Json?
  runs           JobRun[]

  @@index([status, priority])
  @@index([type])
  @@index([teamId])
  @@index([processAt])
  @@index([taskType])
  @@index([tenantId])
  @@index([targetRuntime])
}

model JobRun {
  id            String    @id @default(uuid())
  jobId         String
  status        String
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  retryCount    Int       @default(0)
  correlationId String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([startedAt])
}

model ScrapingJob {
  id        String   @id @default(uuid())
  url       String
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  region    Region   @default(GLOBAL)
  payload   Json?
  tokenMap  Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  @@index([status])
  @@index([region])
}

model Email {
  id               String            @id @default(uuid())
  leadId           String
  campaignId       String
  mailboxId        String?
  subject          String
  body             String
  status           String            @default("sent")
  deliveryProvider String?
  providerId       String?
  threadId         String?
  trackingId       String?           @unique
  openedAt         DateTime?
  clickedAt        DateTime?
  repliedAt        DateTime?
  bouncedAt        DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime          @default(now())
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  lead             Lead              @relation(fields: [leadId], references: [id])
  mailbox          ConnectedMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  events           EmailEvent[]
  trackedLinks     TrackedLink[]
  sequenceStepRuns SequenceStepRun[]

  @@index([leadId])
  @@index([campaignId])
  @@index([mailboxId])
  @@index([status])
  @@index([createdAt])
  @@index([openedAt])
  @@index([clickedAt])
  @@index([repliedAt])
  @@index([bouncedAt])
}

model ConnectedMailbox {
  id                    String    @id @default(uuid())
  teamId                String
  assignedUserId        String?
  provider              String    @default("GOOGLE_WORKSPACE")
  authType              String    @default("OAUTH")
  email                 String
  displayName           String?
  status                String    @default("CONNECTED")
  scopes                String[]  @default([])
  encryptedAccessToken  Json?
  encryptedRefreshToken Json?
  tokenExpiresAt        DateTime?
  lastSyncAt            DateTime?
  historyId             String?
  dailyLimit            Int       @default(50)
  sentToday             Int       @default(0)
  sentTodayDate         DateTime?
  minDelaySeconds       Int       @default(180)
  lastSentAt            DateTime?
  isWarmingUp           Boolean   @default(true)
  warmupDay             Int       @default(0)
  warmupTargetDays      Int       @default(30)
  warmupLastAdvancedAt  DateTime?
  bounceCount           Int       @default(0)
  replyCount            Int       @default(0)
  openCount             Int       @default(0)
  clickCount            Int       @default(0)
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  team                       Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedUser               User?                       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  emails                     Email[]
  events                     EmailEvent[]
  healthSnapshots            MailboxHealthSnapshot[]
  syncCursors                MailboxSyncCursor[]
  sequenceEnrollments        SequenceEnrollment[]
  sequenceStepRuns           SequenceStepRun[]
  trackedLinks               TrackedLink[]
  domainAuthenticationChecks DomainAuthenticationCheck[]

  @@unique([teamId, email])
  @@index([teamId])
  @@index([assignedUserId])
  @@index([status])
}

model EmailEvent {
  id                String   @id @default(uuid())
  teamId            String
  emailId           String?
  mailboxId         String?
  leadId            String?
  campaignId        String?
  type              String
  provider          String?
  providerMessageId String?
  payload           Json?
  processedAt       DateTime?
  createdAt         DateTime @default(now())

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email    Email?            @relation(fields: [emailId], references: [id], onDelete: SetNull)
  mailbox  ConnectedMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  lead     Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  message  Message?

  @@unique([teamId, provider, providerMessageId, type])
  @@index([teamId])
  @@index([emailId])
  @@index([mailboxId])
  @@index([leadId])
  @@index([campaignId])
  @@index([type])
  @@index([createdAt])
}

model SuppressionEntry {
  id        String   @id @default(uuid())
  teamId    String
  email     String
  reason    String   @default("UNSUBSCRIBE")
  source    String   @default("SYSTEM")
  leadId    String?
  createdBy String?
  createdAt DateTime @default(now())

  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lead    Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([teamId, email])
  @@index([teamId])
  @@index([reason])
}

model TrackedLink {
  id             String    @id @default(uuid())
  teamId         String
  emailId        String?
  mailboxId      String?
  campaignId     String?
  leadId         String?
  trackingKey    String
  destinationUrl String    @db.Text
  status         String    @default("ACTIVE")
  clickCount     Int       @default(0)
  firstClickedAt DateTime?
  lastClickedAt  DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email    Email?            @relation(fields: [emailId], references: [id], onDelete: SetNull)
  mailbox  ConnectedMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  campaign Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead     Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([teamId, trackingKey])
  @@index([teamId])
  @@index([emailId])
  @@index([mailboxId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model MailboxHealthSnapshot {
  id                    String   @id @default(uuid())
  teamId                String
  mailboxId             String
  status                String   @default("UNKNOWN")
  bounceRateBasisPoints Int      @default(0)
  replyRateBasisPoints  Int      @default(0)
  openRateBasisPoints   Int      @default(0)
  clickRateBasisPoints  Int      @default(0)
  sentLast24h           Int      @default(0)
  bouncedLast24h        Int      @default(0)
  complainedLast24h     Int      @default(0)
  healthScore           Int      @default(100)
  checkedAt             DateTime @default(now())
  createdAt             DateTime @default(now())

  team    Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mailbox ConnectedMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([teamId, checkedAt])
  @@index([mailboxId, checkedAt])
  @@index([status])
}

model MailboxSyncCursor {
  id                  String    @id @default(uuid())
  teamId              String
  mailboxId           String
  cursorType          String    @default("GMAIL_HISTORY")
  historyId           String?
  pageToken           String?
  lastSyncedAt        DateTime?
  status              String    @default("IDLE")
  consecutiveFailures Int       @default(0)
  lastError           String?   @db.Text
  lockedAt            DateTime?
  lockExpiresAt       DateTime?
  lockToken           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  team    Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mailbox ConnectedMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, cursorType])
  @@index([teamId])
  @@index([status])
  @@index([lastSyncedAt])
}

model CampaignSequence {
  id                String   @id @default(uuid())
  teamId            String
  campaignId        String?
  name              String
  status            String   @default("DRAFT")
  timezone          String   @default("UTC")
  senderMailboxIds  String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  campaign    Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([teamId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model SequenceStep {
  id         String   @id @default(uuid())
  teamId     String
  sequenceId String
  stepOrder  Int
  stepType   String   @default("EMAIL")
  status     String   @default("ACTIVE")
  delayDays  Int      @default(0)
  delayHours Int      @default(0)
  subject    String?
  body       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sequence CampaignSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  runs     SequenceStepRun[]

  @@unique([sequenceId, stepOrder])
  @@index([teamId])
  @@index([sequenceId])
  @@index([status])
}

model SequenceEnrollment {
  id               String    @id @default(uuid())
  teamId           String
  sequenceId       String
  leadId           String
  mailboxId        String?
  campaignId       String?
  status           String    @default("ACTIVE")
  currentStepOrder Int       @default(0)
  nextRunAt        DateTime?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  cancelledAt      DateTime?
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sequence CampaignSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mailbox  ConnectedMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  campaign Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  runs     SequenceStepRun[]

  @@unique([sequenceId, leadId])
  @@index([teamId])
  @@index([leadId])
  @@index([mailboxId])
  @@index([campaignId])
  @@index([status])
  @@index([nextRunAt])
}

model SequenceStepRun {
  id                String    @id @default(uuid())
  teamId            String
  enrollmentId      String
  sequenceStepId    String
  mailboxId         String?
  emailId           String?
  leadId            String?
  campaignId        String?
  status            String    @default("SCHEDULED")
  scheduledAt       DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  attemptCount      Int       @default(0)
  providerMessageId String?
  errorCode         String?
  errorMessage      String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  team       Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       SequenceStep       @relation(fields: [sequenceStepId], references: [id], onDelete: Cascade)
  mailbox    ConnectedMailbox?  @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  email      Email?             @relation(fields: [emailId], references: [id], onDelete: SetNull)
  lead       Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign   Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([enrollmentId])
  @@index([sequenceStepId])
  @@index([mailboxId])
  @@index([emailId])
  @@index([leadId])
  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
  @@index([providerMessageId])
}

model DomainAuthenticationCheck {
  id            String    @id @default(uuid())
  teamId        String
  mailboxId     String?
  domain        String
  status        String    @default("UNKNOWN")
  spfStatus     String    @default("UNKNOWN")
  dkimStatus    String    @default("UNKNOWN")
  dmarcStatus   String    @default("UNKNOWN")
  mxStatus      String    @default("UNKNOWN")
  lastCheckedAt DateTime?
  nextCheckAt   DateTime?
  failureReason String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team    Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mailbox ConnectedMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  @@unique([teamId, domain])
  @@index([teamId])
  @@index([mailboxId])
  @@index([status])
  @@index([nextCheckAt])
}

model Settings {
  id            String                @id @default(uuid())
  userId        String                @unique
  name          String?
  email         String?
  theme         String                @default("dark")
  apiKeyOpenAI  String?
  apiKeyGemini  String?
  hubspotApiKey String?
  crmConfig     Json? // Stores mapping rules, sync status
  liCookie      String?
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id])
  notifications NotificationSettings?
}

model NotificationSettings {
  id            String   @id @default(uuid())
  userId        String   @unique
  settingsId    String   @unique
  emailGlobal   Boolean  @default(true)
  emailCampaign Boolean  @default(true)
  emailLeads    Boolean  @default(true)
  inAppGlobal   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settings Settings @relation(fields: [settingsId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  meta      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ManualReview {
  id       String @id @default(uuid())
  source   String // "Sentinel", "Scraper"
  payload  Json // The raw data that was quarantined
  reason   String // "Low Quality", "Schema Mismatch", "Honeypot Suspected"
  severity String // "WARN", "CRITICAL"
  region   String @default("GLOBAL")
  status   String @default("PENDING") // PENDING, APPROVED, REJECTED

  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([severity])
}

model Team {
  id               String              @id @default(uuid())
  name             String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  credits          Int                 @default(100)
  campaigns        Campaign[]
  templates        EmailTemplate[]
  jobs             Job[]
  scrapingJobs     ScrapingJob[]
  leads            Lead[]
  meetings         Meeting[]
  // subscription Subscription? // Moved to User
  members          TeamMember[]
  webhooks         Webhook[]
  automations      Automation[]
  schedules        Schedule[]
  workflows        Workflow[]
  guardrailPolicy  GuardrailPolicy?
  transactions     CreditTransaction[]
  auditLogs        AuditLog[]
  memories         AgentMemory[]
  apiKeys          ApiKey[]
  tasks            Task[]
  landingCampaigns LandingCampaign[]
  landingPages     LandingPage[]
  landingLeads     LandingLead[]
  landingEvents    LandingEvent[]
  invoices         Invoice[]

  // Billing address (used for invoice GST treatment: India + same state as
  // seller = CGST/SGST, India + other state = IGST, non-India = zero-rated export)
  billingCountry String?
  billingState   String?

  // Physical postal address shown in outbound marketing email footers.
  // Required for CAN-SPAM compliance; not set = no footer is injected.
  mailingAddress String?

  branding                   Json? // { logoUrl, primaryColor, portalTitle }
  aiConfig                   Json? // Global agent settings (voice, tone, constraints)
  domains                    CustomDomain[]
  knowledgeBases             KnowledgeBase[]
  playbooks                  Playbook[]
  organizationPolicy         OrganizationPolicy?
  ssoConfiguration           SsoConfiguration?
  userQuotas                 UserQuota[]
  crmIntegrations            CrmIntegration[]
  icps                       ICP[]
  paymentAccounts            PaymentAccount[]
  products                   Product[]
  orders                     Order[]
  approvalRequests           ApprovalRequest[]
  caseStudies                CaseStudy[]
  agentTasks                 AgentTask[]
  agentFeedbackLoops         AgentFeedbackLoop[]
  Experiment                 Experiment[]
  ImmutableAudit             ImmutableAudit[]
  contractProfile            ContractProfile?
  shadowSignals              ShadowSignal[]
  connectedMailboxes         ConnectedMailbox[]
  emailEvents                EmailEvent[]
  suppressionEntries         SuppressionEntry[]
  trackedLinks               TrackedLink[]
  mailboxHealthSnapshots     MailboxHealthSnapshot[]
  mailboxSyncCursors         MailboxSyncCursor[]
  campaignSequences          CampaignSequence[]
  sequenceSteps              SequenceStep[]
  sequenceEnrollments        SequenceEnrollment[]
  sequenceStepRuns           SequenceStepRun[]
  domainAuthenticationChecks DomainAuthenticationCheck[]
  userInvitations            UserInvitation[]
  edgeNode                   EdgeNode?
  outboxEvents               OutboxEvent[]
  blindIndexes               BlindIndex[]
}

model CrmIntegration {
  id       String @id @default(cuid())
  teamId   String
  provider String // HUBSPOT, SALESFORCE

  // Auth
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?

  // Config
  isActive     Boolean @default(true)
  fieldMapping Json? // { "fullName": "firstname", "email": "email", ... }
  syncSettings Json? // { "autoSync": true, "syncOnWon": true }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, provider])
}

model SsoConfiguration {
  id           String @id @default(cuid())
  teamId       String @unique
  providerType String @default("SAML") // SAML, OIDC

  // SAML Specifics
  metadataUrl String? // URL to IdP metadata
  issuer      String? // Entity ID / Issuer
  entryPoint  String? // SSO URL
  certificate String? @db.Text // Public Cert

  // OIDC Specifics
  clientId     String?
  clientSecret String?
  wellKnownUrl String?

  enforced       Boolean  @default(false) // If true, password login is disabled for domain
  allowedDomains String[] @default([]) // ["enterprise.com", "sub.enterprise.com"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  teamId      String
  amount      Int // Negative for usage, positive for top-up
  description String
  type        String // "usage", "topup", "bonus"
  meta        Json? // Store jobId or other context
  // Set only for payment-triggered grants (Razorpay webhook). Unique so a duplicate
  // webhook delivery is rejected by the DB instead of relying on a check-then-write
  // read, which is racy under concurrent deliveries. Null for usage/refund/bonus
  // transactions, which Postgres does not enforce uniqueness across.
  paymentId   String?  @unique
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  planId           String
  status           String // active, trialing, canceled
  currentPeriodEnd DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
  plan             Plan      @relation(fields: [planId], references: [id])
  invoices         Invoice[]
}

model Plan {
  id              String         @id @default(uuid())
  name            String         @unique // FREE, PRO, ENTERPRISE
  monthlyPrice    Int
  creditsPerMonth Int
  maxAgents       Int
  features        Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model CreditLedger {
  id        String   @id @default(uuid())
  userId    String
  amount    Int // Positive for added credits, negative for deducted
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  teamId         String
  userId         String
  subscriptionId String?
  type           String // subscription, topup
  description    String
  amount         Int // total amount actually charged, in the currency's smallest unit - the source of truth, never re-derived from a live Plan price
  currency       String
  paymentId      String
  orderId        String?

  // GST breakup - null/NONE when the sale is a non-India zero-rated export of services.
  // GST is added on top of taxableValue at order-creation time: amount = taxableValue + taxAmount.
  taxableValue Int?
  taxAmount    Int?
  taxType      String? // CGST_SGST (same state as seller), IGST (other Indian state), NONE (export)
  taxRate      Int? // percent, e.g. 18

  billingCountry String?
  billingState   String?

  status       String // paid, refunded
  createdAt    DateTime      @default(now())
  team         Team          @relation(fields: [teamId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([teamId])
  @@index([paymentId])
}

model Webhook {
  id        String       @id @default(uuid())
  url       String
  events    String[]
  secret    String?
  isActive  Boolean      @default(true)
  teamId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  team      Team         @relation(fields: [teamId], references: [id])
  logs      WebhookLog[]

  @@index([teamId])
}

model WebhookLog {
  id        String   @id @default(uuid())
  webhookId String
  event     String
  status    Int // HTTP status code
  payload   Json
  response  Json?
  error     String?
  duration  Int // Dispatch duration in ms
  createdAt DateTime @default(now())
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
}

model Meeting {
  id        String   @id @default(uuid())
  title     String
  startTime DateTime
  endTime   DateTime
  notes     String?
  leadId    String?
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead?    @relation(fields: [leadId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([leadId])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String?
  email     String
  role      String   @default("member")
  status    String   @default("invited")
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([teamId])
  @@index([userId])
}

model User {
  id                  String             @id @default(uuid())
  clerkUserId         String?            @unique @map("clerk_user_id")
  email               String             @unique
  password            String? // <-- Add this line
  emailVerified       DateTime?
  name                String?
  image               String?
  address             String?
  role                String             @default("user") // Legacy
  enterpriseRole      UserRole           @default(SALES_USER) // Enterprise RBAC
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  settings            Settings?
  memberships         TeamMember[]
  accounts            Account[]
  sessions            Session[]
  campaigns           Campaign[]         @relation("owner_campaigns")
  landingCampaigns    LandingCampaign[]  @relation("LandingCampaignOwner")
  connectedMailboxes  ConnectedMailbox[]
  createdSuppressions SuppressionEntry[]

  // Billing
  credits            Int               @default(0)
  subscription       Subscription?
  creditLedger       CreditLedger[]
  llmUsageLogs       LLMUsageLog[]     @relation("LLMUsageActor")
  auditLogs          AuditLog[]
  tasks              Task[]
  userQuotas         UserQuota[]
  requestedApprovals ApprovalRequest[] @relation("requester")
  reviewedApprovals  ApprovalRequest[] @relation("reviewer")
  agentTasks         AgentTask[]
  datasetReviews     DatasetReview[]
  sentInvitations    UserInvitation[]
  approvedInviteRequests InviteRequest[] @relation("InviteRequestApprovedBy")
  invoices           Invoice[]

  // Caller Role (Part 4)
  isCaller           Boolean                    @default(false)
  callerTeamId       String? // Which team this caller works for
  callerMaxQueueSize Int                        @default(10) // Max assigned items at once
  callerActiveAt     DateTime? // Last activity timestamp
  callerAssignments  MeetingCoordinationQueue[] @relation("caller_assignments")
  edgeNodeUri        String? // Individual Phi-3 Edge Node binding
}

model UserInvitation {
  id          String           @id @default(uuid())
  email       String
  role        UserRole
  teamId      String
  invitedById String
  tokenHash   String           @unique
  status      InvitationStatus @default(pending)
  expiresAt   DateTime
  acceptedAt  DateTime?
  inviteRequestId String?          @map("invite_request_id")
  createdAt   DateTime         @default(now())

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy     User           @relation(fields: [invitedById], references: [id])
  inviteRequest InviteRequest? @relation(fields: [inviteRequestId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([teamId])
  @@index([invitedById])
  @@index([inviteRequestId])
  @@index([status])
  @@index([expiresAt])
}

model InviteRequest {
  id          String              @id @default(uuid())
  name        String
  email       String
  company     String
  linkedinUrl String              @map("linkedin_url")
  useCase     String              @map("use_case") @db.Text
  status      InviteRequestStatus @default(WAITLISTED)
  inviteToken String?             @unique @map("invite_token")
  approvedById String?            @map("approved_by_id")
  approvedAt  DateTime?           @map("approved_at")
  usedAt      DateTime?           @map("used_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  approvedBy User?            @relation("InviteRequestApprovedBy", fields: [approvedById], references: [id])
  invitations UserInvitation[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([approvedById])
  @@map("invite_requests")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Message {
  id             String          @id @default(uuid())
  leadId         String
  content        String
  direction      String // INBOUND, OUTBOUND
  platform       String // LINKEDIN, EMAIL
  sender         String? // Name of sender
  status         String          @default("received") // received, sent, draft
  isRead         Boolean         @default(false)
  sentimentScore Float? // -1.0 to 1.0
  emailEventId    String?         @unique
  createdAt      DateTime        @default(now())
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailEvent     EmailEvent?     @relation(fields: [emailEventId], references: [id], onDelete: SetNull)
  feedback       AgentFeedback[]

  @@index([leadId])
}

model Automation {
  id               String          @id @default(uuid())
  name             String
  trigger          String // "lead.replied", "ai.suggestion"
  action           String // "campaign.stop", "email.reply", "webhook.call"
  config           Json? // { "templateId": "...", "model": "gemini-pro" }
  isActive         Boolean         @default(true)
  requiresApproval Boolean         @default(false)
  teamId           String
  team             Team            @relation(fields: [teamId], references: [id])
  logs             AutomationLog[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([teamId])
}

model AutomationLog {
  id           String     @id @default(uuid())
  automationId String
  status       String // "pending_approval", "success", "failed", "rejected"
  tokensUsed   Int        @default(0)
  cost         Float      @default(0.0)
  input        Json? // Added for human review context
  output       Json? // AI response or Action result
  reasoning    String?    @db.Text // CoT explanation
  metadata     Json? // Added for implementation details
  executedAt   DateTime? // When the task was executed by the extension
  durationMs   Int?       @default(0) // Execution duration
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id])

  @@index([automationId])
  @@index([status])
}

model Schedule {
  id        String    @id @default(uuid())
  name      String
  cron      String // e.g., "0 9 * * 1-5" (Weekdays at 9am)
  timezone  String    @default("UTC")
  isActive  Boolean   @default(true)
  nextRunAt DateTime?
  lastRunAt DateTime?

  // Configuration
  batchSize       Int   @default(50)
  groundingConfig Json? // { useRag: true, collectionId: "..." }

  // Relations
  teamId     String
  campaignId String? // Optional: specific campaign to run
  agentId    String? // Optional: specific agent to run
  team       Team          @relation(fields: [teamId], references: [id])
  logs       ScheduleLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([isActive, nextRunAt])
}

model ScheduleLog {
  id            String   @id @default(uuid())
  scheduleId    String
  status        String // "success", "failed"
  message       String?
  tokensUsed    Int      @default(0)
  creditsUsed   Int      @default(0)
  itemsVariable Int      @default(0) // How many items processed
  createdAt     DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId])
}

model Workflow {
  id            String   @id @default(uuid())
  name          String
  description   String?
  triggerType   String   @default("MANUAL") // MANUAL, EVENT (e.g. lead.created)
  triggerConfig Json? // Configuration for the trigger
  nodes         Json // ReactFlow nodes
  edges         Json // ReactFlow edges
  isActive      Boolean  @default(false)
  teamId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team Team          @relation(fields: [teamId], references: [id])
  runs WorkflowRun[]

  @@index([teamId])
}

model WorkflowRun {
  id            String    @id @default(uuid())
  workflowId    String
  status        String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  currentStepId String? // ID of the current node in the graph
  context       Json? // Variables and state
  entityId      String? // ID of the Lead or object this is running for
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  error         String?

  // AI Audit
  tokensUsed Int       @default(0)
  reasoning  String?   @db.Text
  traces     AiTrace[]

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
  @@index([status])
}

model AiTrace {
  id        String   @id @default(uuid())
  runId     String?
  stepName  String
  input     String?  @db.Text
  output    String?  @db.Text
  reasoning String?  @db.Text // CoT thought process
  model     String?
  latency   Int
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  workflowRun WorkflowRun? @relation(fields: [runId], references: [id])

  @@index([runId])
}

model GuardrailPolicy {
  id                 String   @id @default(uuid())
  teamId             String   @unique
  blocklist          String[] // Blocked keywords
  allowlist          String[] // Explicitly allowed domains/words
  regexRules         String[] // Custom regex patterns to block
  competitorMentions String[] // Competitor names to flag
  maxDailyMsgs       Int      @default(100)
  detectPII          Boolean  @default(true)
  strictness         String   @default("medium") // low, medium, high
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
}

model GuardrailLog {
  id            String   @id @default(uuid())
  teamId        String
  userId        String?
  action        String // "blocked", "flagged"
  violationType String // "pii", "toxic", "competitor", "custom_regex"
  reason        String // Specific rule triggered
  content       String?  @db.Text // The blocked content (snippet)
  metadata      Json? // Context about the violation
  createdAt     DateTime @default(now())

  @@index([teamId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("userId")
  orgId         String   @map("teamId")
  correlationId String?
  action        String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity        String   @map("resource")
  entityId      String?  @map("resourceId")
  metadata      Json?    @map("details") // Metadata
  ipAddress     String?
  createdAt     DateTime @default(now())

  team Team  @relation(fields: [orgId], references: [id])
  user User? @relation(fields: [actorId], references: [id])

  @@index([orgId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  // Optimization for recent activity feeds
  @@index([orgId, createdAt])
}

model MarketplaceTemplate {
  id          String   @id @default(uuid())
  name        String
  description String
  type        String // AGENT, WORKFLOW, PLAYBOOK, CAMPAIGN
  category    String // Sales, Support, Recruiting
  icon        String?
  config      Json // The JSON config (Workflow structure or Campaign steps)
  metrics     Json? // e.g. { "avgOpenRate": 0.45, "users": 1000 }
  isOfficial  Boolean  @default(true)
  author      String   @default("CraftMyFunnel")
