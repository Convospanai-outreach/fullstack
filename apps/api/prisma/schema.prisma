  organizationId String      @unique
  productMode    ProductMode @default(ENTERPRISE_CORE)
  executionMode  String?     @default("saas_only")
  productSurface String?     @default("outreach")

  maxDailyActions Int @default(200)
  maxCampaigns    Int @default(10)
  maxAgents       Int @default(5)

  allowInMail   Boolean @default(false)
  allowScraping Boolean @default(false)
  allowUploads  Boolean @default(true)

  requiresApprovalForCampaign Boolean @default(false)

  // Compliance Settings
  blockedKeywords String[] @default([])
  detectPII       Boolean  @default(false)
