// --- ENTERPRISE MICRO-LLM TRAINING INFRASTRUCTURE ---

enum TrainingTaskType {
  TONE_NORMALIZATION
  GRAMMAR_REPAIR
  BRAND_ENFORCEMENT
  POLICY_CLASSIFICATION
  POLICY_REWRITE
  CONVERSATION_SUMMARY
  OBJECTION_EXTRACTION
  REFUSAL_GENERATION
}

enum DatasetStatus {
  DRAFT
  IN_REVIEW
  REVIEWED
  TRAINING
  DEPLOYED
}

enum ModelStatus {
  TRAINING
  VALIDATION
  DEPLOYED
  ROLLED_BACK
  DEPRECATED
}

model TrainingDataset {
  id          String           @id @default(uuid())
  version     String           @unique
  taskType    TrainingTaskType
  recordCount Int              @default(0)
  datasetHash String
  configHash  String
  status      DatasetStatus    @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  records       TrainingRecord[]
  reviews       DatasetReview[]
  modelVersions ModelVersion[]

  @@index([status])
  @@index([taskType])
}

model TrainingRecord {
  id                  String           @id @default(uuid())
  datasetId           String
  taskType            TrainingTaskType
  inputText           String           @db.Text
  brandRules          Json
  policyRules         Json
  expectedOutput      String           @db.Text
  rejectionConditions Json
  reviewScore         Float?
  reviewedBy          String?
  reviewedAt          DateTime?
  approved            Boolean          @default(false)
  createdAt           DateTime         @default(now())

  dataset TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([approved])
  @@index([reviewScore])
}

model DatasetReview {
  id                String   @id @default(uuid())
  datasetId         String
  reviewerId        String
  sampleSize        Int
  avgScore          Float
  policyCorrectness Float
  toneQuality       Float
  clarity           Float
  realism           Float
  refusalQuality    Float?
  notes             String?  @db.Text
  approved          Boolean
  createdAt         DateTime @default(now())

  dataset  TrainingDataset @relation(fields: [datasetId], references: [id])
  reviewer User            @relation(fields: [reviewerId], references: [id])

  @@index([datasetId])
  @@index([reviewerId])
}

model ModelVersion {
  id                  String      @id @default(uuid())
  version             String      @unique
  baseModel           String
  datasetId           String
  configHash          String
  changelog           String      @db.Text
  status              ModelStatus @default(TRAINING)
  refusalAccuracy     Float?
  policyViolationRate Float?
  driftScore          Float?
  verbosityScore      Float?
  deployedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  dataset TrainingDataset    @relation(fields: [datasetId], references: [id])
  metrics EvaluationMetric[]

  @@index([status])
  @@index([version])
}

model EvaluationMetric {
  id             String   @id @default(uuid())
  modelVersionId String
  metricType     String // REFUSAL_ACC, POLICY_VIOLATION, DRIFT, VERBOSITY
  value          Float
  threshold      Float
  passed         Boolean
  metadata       Json?
  timestamp      DateTime @default(now())

  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id])

  @@index([modelVersionId])
  @@index([metricType])
  @@index([passed])
}

// --- END ML TRAINING INFRASTRUCTURE ---

