}

model AgentMemory {
  id         String   @id @default(uuid())
  teamId     String
  key        String // e.g. "tone_preference", "forbidden_phrase"
  value      String // e.g. "Always use emojis", "Never mention 'cheap'"
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())

