model UserQuota {
  id           String   @id @default(cuid())
  userId       String
  teamId       String
  monthlyLimit Int
  currentSpend Int      @default(0)
  lastReset    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model ApprovalRequest {
  id          String @id @default(uuid())
  teamId      String
  requesterId String
  actionType  String // "CAMPAIGN_START", "LIMIT_INCREASE"
  entityType  String // "Campaign"
  entityId    String
  status      String @default("PENDING") // PENDING, APPROVED, REJECTED

  reason  String? // Why is this requested?
  payload Json? // Data needed to execute the action

  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team  @relation(fields: [teamId], references: [id])
  requester User  @relation("requester", fields: [requesterId], references: [id])
  reviewer  User? @relation("reviewer", fields: [reviewerId], references: [id])

  @@index([teamId])
  @@index([status])
}

model Playbook {
  id          String   @id @default(uuid())
  name        String
  description String?
  teamId      String
  config      Json // The campaign template (messages, steps)
  parameters  Json? // e.g. ["companyName", "offer"]
  isLocked    Boolean  @default(false)
  visibility  String   @default("INTERNAL") // INTERNAL, PUBLIC
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

// Industry Case Studies for RAG-Enhanced Marketing Copy
model CaseStudy {
  id             String   @id @default(uuid())
  title          String
  industry       String // e.g., "SaaS", "Healthcare", "Finance"
  summary        String   @db.Text
  content        String   @db.Text
  metrics        Json? // { conversionRate: 0.42, roi: 3.5, timeToClose: 14 }
  embedding      String? // Temporarily String
  embeddingModel String?  @default("embedding-001")
  teamId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([industry])
}

// Verification Agent Audit Log
model VerificationLog {
  id             String   @id @default(uuid())
  leadId         String
  teamId         String
  passed         Boolean
  score          Float
  threshold      Float
  recommendation String // PROCESS, REVIEW, REJECT
  violations     Json? // Array of violations
  explanation    Json? // Full score explanation
  createdAt      DateTime @default(now())

  @@index([leadId])
  @@index([teamId])
  @@index([createdAt])
