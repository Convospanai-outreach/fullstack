{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server.ts",
    "routes/**/*.ts",
    "workers/**/*.ts",
    "services/**/*.ts",
    "utils/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**",
    "node_modules",
    "dist"
  ]
}
