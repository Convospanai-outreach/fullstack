# Blank template for the marketing site. Supply deployment values separately.

# Required in production. Product app origin for links, redirects, and API rewrites.
NEXT_PUBLIC_APP_URL=

# Public marketing origin for canonicals, sitemap, robots, and markdown responses.
NEXT_PUBLIC_SITE_URL=

# Optional browser analytics key for PostHog.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional browser analytics ingestion origin for PostHog.
NEXT_PUBLIC_POSTHOG_HOST=

# Optional GA4 measurement ID. The root layout checks the CMS setting first.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional legacy GA4 measurement ID fallback.
NEXT_PUBLIC_GA_ID=

# Optional Google Search Console verification value for site metadata.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional public Turnstile key for rendering the browser widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional browser Sentry DSN for client errors and tracing.
NEXT_PUBLIC_SENTRY_DSN=

# Optional server Sentry DSN for errors and tracing in the Node runtime.
SENTRY_DSN=

# Framework-provided mode for build and runtime checks. Leave unset.
# NODE_ENV=

# Next.js-provided runtime selector for server instrumentation. Leave unset.
# NEXT_RUNTIME=

# CI-provided flag for Playwright server mode and Sentry build output. Leave unset.
# CI=
