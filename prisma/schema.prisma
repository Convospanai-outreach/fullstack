generator client {
  provider = "prisma-client-js"
  engineType = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model Lead {
  id           String    @id @default(uuid())
  fullName     String?
  email        String?
  linkedIn     String?
  company      String?
  jobTitle     String?
  location     String?
  status       String    @default("NEW")
  tags         String[]
  isEnriched   Boolean   @default(false)
  enrichedData Json?
  embedding    Json?
  value        Float?    @default(0.0) // Potential Deal Value
  wonAt        DateTime? // When it was marked CLOSED_WON
  lostAt       DateTime? // When it was marked CLOSED_LOST
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  campaignId   String?
  teamId       String?
  
  // CRM Sync
  crmId        String?   // External ID in HubSpot/Salesforce
  crmSyncedAt  DateTime?

  emails       Email[]
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  team         Team?     @relation(fields: [teamId], references: [id])
  meetings     Meeting[]
  messages     Message[]
  tasks        Task[]

  @@index([teamId])
  @@index([email])
  @@index([company])
  @@index([status])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String   @default("TODO") // TODO, DONE
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  leadId      String?
  userId      String
  teamId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id])
  team        Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([userId])
  @@index([leadId])
  @@index([status])
}

model Campaign {
  id             String            @id @default(uuid())
  name           String
  description    String?
  audience       String?
  status         String            @default("draft")
  type           String            @default("standard") // standard, smart
  aiConfig       Json?             // Stores { tone, goal, context, prompt }
  targetCount    Int               @default(0)
  completedCount Int               @default(0)
  leads          Int               @default(0) // User requested Int field for count
  consecutiveFailures Int          @default(0) // Track sequential job failures
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  teamId         String?
  ownerId        String?
  team           Team?             @relation(fields: [teamId], references: [id])
  owner          User?             @relation("owner_campaigns", fields: [ownerId], references: [id])
  variants       CampaignVariant[]
  emails         Email[]
  
  scheduledStart DateTime?         // <-- Added field

  // Relations
  leadList       Lead[]            // Renamed relation to avoid conflict with 'leads' Int

  activities     Activity[]

  @@index([status])
  @@index([teamId])
  @@index([createdAt])
}

model CampaignVariant {
  id         String   @id @default(uuid())
  campaignId String
  subject    String
  body       String
  weight     Int      @default(50)
  sentCount  Int      @default(0)
  openCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model Activity {
  id         String   @id @default(uuid())
  type       String
  message    String?
  meta       Json?
  createdAt  DateTime @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  agentId    String?
}

model Agent {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("idle")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ICP {
  id          String   @id @default(uuid())
  name        String
  description String?
  criteria    Json
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}
model Job {
  id          String    @id @default(uuid())
  type        String
  status      String    @default("pending")
  priority    Int       @default(0)
  payload     Json
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  processAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id])
  idempotencyKey String? @unique

  @@index([status, priority])
  @@index([type])
  @@index([teamId])
  @@index([processAt])
}

model Email {
  id         String    @id @default(uuid())
  leadId     String
  campaignId String
  subject    String
  body       String
  status     String    @default("sent")
  providerId String?
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime  @default(now())
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  lead       Lead      @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([openedAt])
  @@index([clickedAt])
}

model Settings {
  id           String   @id @default(uuid())
  userId       String   @unique
  name         String?
  email        String?
  theme        String   @default("dark")
  apiKeyOpenAI String?
  apiKeyGemini String?
  hubspotApiKey String?
  crmConfig    Json?    // Stores mapping rules, sync status
  liCookie     String?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  notifications NotificationSettings?
}

model NotificationSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  settingsId String  @unique
  emailGlobal Boolean @default(true)
  emailCampaign Boolean @default(true)
  emailLeads Boolean @default(true)
  inAppGlobal Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  settings  Settings @relation(fields: [settingsId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  meta      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id           String          @id @default(uuid())
  name         String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  credits      Int             @default(100)
  campaigns    Campaign[]
  templates    EmailTemplate[]
  jobs         Job[]
  leads        Lead[]
  meetings     Meeting[]
  // subscription Subscription? // Moved to User
  members      TeamMember[]
  webhooks     Webhook[]
  automations  Automation[]
  schedules    Schedule[]
  workflows    Workflow[]
  guardrailPolicy GuardrailPolicy?
  transactions CreditTransaction[]
  auditLogs    AuditLog[]
  memories     AgentMemory[]
  apiKeys      ApiKey[]
  tasks        Task[]
  
  branding     Json?       // { logoUrl, primaryColor, portalTitle }
  domains      CustomDomain[]
  knowledgeBases KnowledgeBase[]
  playbooks    Playbook[]
  organizationPolicy OrganizationPolicy?
  ssoConfiguration SsoConfiguration?
  userQuotas       UserQuota[]
  crmIntegrations  CrmIntegration[]
  approvalRequests ApprovalRequest[]
}

model CrmIntegration {
  id              String   @id @default(cuid())
  teamId          String
  provider        String   // HUBSPOT, SALESFORCE
  
  // Auth
  accessToken     String?  @db.Text
  refreshToken    String?  @db.Text
  expiresAt       DateTime?
  
  // Config
  isActive        Boolean  @default(true)
  fieldMapping    Json?    // { "fullName": "firstname", "email": "email", ... }
  syncSettings    Json?    // { "autoSync": true, "syncOnWon": true }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team            Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, provider])
}

model SsoConfiguration {
  id              String   @id @default(cuid())
  teamId          String   @unique
  providerType    String   @default("SAML") // SAML, OIDC
  
  // SAML Specifics
  metadataUrl     String?  // URL to IdP metadata
  issuer          String?  // Entity ID / Issuer
  entryPoint      String?  // SSO URL
  certificate     String?  @db.Text // Public Cert
  
  // OIDC Specifics
  clientId        String?
  clientSecret    String?
  wellKnownUrl    String?

  enforced        Boolean  @default(false) // If true, password login is disabled for domain
  allowedDomains  String[] @default([]) // ["enterprise.com", "sub.enterprise.com"]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team            Team     @relation(fields: [teamId], references: [id])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  teamId      String
  amount      Int      // Negative for usage, positive for top-up
  description String
  type        String   // "usage", "topup", "bonus"
  meta        Json?    // Store jobId or paymentId
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  planId               String
  status               String   // active, trialing, canceled
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
  plan                 Plan     @relation(fields: [planId], references: [id])
  invoices             Invoice[]
}

model Plan {
  id              String         @id @default(uuid())
  name            String         @unique // FREE, PRO, ENTERPRISE
  monthlyPrice    Int
  creditsPerMonth Int
  maxAgents       Int
  features        Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model CreditLedger {
  id        String   @id @default(uuid())
  userId    String
  amount    Int      // Positive for added credits, negative for deducted
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Invoice {
  id             String       @id @default(uuid())
  subscriptionId String
  amount         Int
  status         String
  invoiceUrl     String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  events    String[]
  secret    String?
  isActive  Boolean  @default(true)
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id])
  logs      WebhookLog[]

  @@index([teamId])
}

model WebhookLog {
  id            String   @id @default(uuid())
  webhookId     String
  event         String
  status        Int      // HTTP status code
  payload       Json
  response      Json?
  error         String?
  duration      Int      // Dispatch duration in ms
  createdAt     DateTime @default(now())
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
}

model Meeting {
  id        String   @id @default(uuid())
  title     String
  startTime DateTime
  endTime   DateTime
  notes     String?
  leadId    String?
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead?    @relation(fields: [leadId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([leadId])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String?
  email     String
  role      String   @default("member")
  status    String   @default("invited")
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([teamId])
  @@index([userId])
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String?      // <-- Add this line
  emailVerified DateTime?
  name          String?
  image         String?
  address       String?
  role          String       @default("user")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  settings      Settings?
  memberships   TeamMember[]
  accounts      Account[]
  sessions      Session[]
  campaigns     Campaign[]   @relation("owner_campaigns")
  
  // Billing
  credits      Int            @default(0)
  subscription Subscription?
  creditLedger CreditLedger[]
  auditLogs    AuditLog[]
  tasks        Task[]
  userQuotas   UserQuota[]
  requestedApprovals ApprovalRequest[] @relation("requester")
  reviewedApprovals  ApprovalRequest[] @relation("reviewer")
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Message {
  id        String   @id @default(uuid())
  leadId    String
  content   String
  direction String   // INBOUND, OUTBOUND
  platform  String   // LINKEDIN, EMAIL
  sender    String?  // Name of sender
  status    String   @default("received") // received, sent, draft
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  feedback  AgentFeedback[]
  @@index([leadId])
}

model Automation {
  id              String   @id @default(uuid())
  name            String
  trigger         String   // "lead.replied", "ai.suggestion"
  action          String   // "campaign.stop", "email.reply", "webhook.call"
  config          Json?    // { "templateId": "...", "model": "gemini-pro" }
  isActive        Boolean  @default(true)
  requiresApproval Boolean @default(false)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  logs            AutomationLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String
  status       String   // "pending_approval", "success", "failed", "rejected"
  tokensUsed   Int      @default(0)
  cost         Float    @default(0.0)
  input        Json?    // Added for human review context
  output       Json?    // AI response or Action result
  reasoning    String?  @db.Text // CoT explanation
  metadata     Json?    // Added for implementation details
  createdAt    DateTime @default(now())
  automation   Automation @relation(fields: [automationId], references: [id])

  @@index([automationId])
  @@index([status])
}

model Schedule {
  id             String        @id @default(uuid())
  name           String
  cron           String        // e.g., "0 9 * * 1-5" (Weekdays at 9am)
  timezone       String        @default("UTC")
  isActive       Boolean       @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  
  // Configuration
  batchSize      Int           @default(50)
  groundingConfig Json?        // { useRag: true, collectionId: "..." }
  
  // Relations
  teamId         String
  campaignId     String?       // Optional: specific campaign to run
  agentId        String?       // Optional: specific agent to run
  team           Team          @relation(fields: [teamId], references: [id])
  logs           ScheduleLog[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([teamId])
  @@index([isActive, nextRunAt])
}

model ScheduleLog {
  id          String   @id @default(uuid())
  scheduleId  String
  status      String   // "success", "failed"
  message     String?
  tokensUsed  Int      @default(0)
  creditsUsed Int      @default(0)
  itemsVariable Int    @default(0) // How many items processed
  createdAt   DateTime @default(now())
  
  schedule    Schedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId])
}

model Workflow {
  id          String        @id @default(uuid())
  name        String
  description String?
  triggerType String        @default("MANUAL") // MANUAL, EVENT (e.g. lead.created)
  triggerConfig Json?       // Configuration for the trigger
  nodes       Json          // ReactFlow nodes
  edges       Json          // ReactFlow edges
  isActive    Boolean       @default(false)
  teamId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  team        Team          @relation(fields: [teamId], references: [id])
  runs        WorkflowRun[]

  @@index([teamId])
}

model WorkflowRun {
  id            String    @id @default(uuid())
  workflowId    String
  status        String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  currentStepId String?   // ID of the current node in the graph
  context       Json?     // Variables and state
  entityId      String?   // ID of the Lead or object this is running for
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  error         String?
  
  // AI Audit
  tokensUsed    Int       @default(0)
  reasoning     String?   @db.Text
  traces        AiTrace[]

  workflow      Workflow  @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
  @@index([status])
}

model AiTrace {
  id          String   @id @default(uuid())
  runId       String?
  stepName    String
  input       String?  @db.Text
  output      String?  @db.Text
  reasoning   String?  @db.Text // CoT thought process
  model       String?
  latency     Int
  tokens      Int      @default(0)
  createdAt   DateTime @default(now())

  workflowRun WorkflowRun? @relation(fields: [runId], references: [id])
  
  @@index([runId])
}

model GuardrailPolicy {
  id          String   @id @default(uuid())
  teamId      String   @unique
  blocklist   String[] // Blocked keywords
  allowlist   String[] // Explicitly allowed domains/words
  regexRules  String[] // Custom regex patterns to block
  competitorMentions String[] // Competitor names to flag
  maxDailyMsgs Int     @default(100)
  detectPII   Boolean  @default(true)
  strictness  String   @default("medium") // low, medium, high
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  team        Team     @relation(fields: [teamId], references: [id])
}

model GuardrailLog {
  id          String   @id @default(uuid())
  teamId      String
  userId      String?
  action      String   // "blocked", "flagged"
  violationType String // "pii", "toxic", "competitor", "custom_regex"
  reason      String   // Specific rule triggered
  content     String?  @db.Text // The blocked content (snippet)
  metadata    Json?    // Context about the violation
  createdAt   DateTime @default(now())

  @@index([teamId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("userId")
  orgId     String   @map("teamId")
  action    String   // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity    String   @map("resource") // e.g. "Campaign", "Workflow", "TeamMember"
  entityId  String?  @map("resourceId")
  metadata  Json?    @map("details") // Metadata
  ipAddress String?
  createdAt DateTime @default(now())
  
  team      Team     @relation(fields: [orgId], references: [id])
  user      User?    @relation(fields: [actorId], references: [id])

  @@index([orgId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model MarketplaceTemplate {
  id          String   @id @default(uuid())
  name        String
  description String
  type        String   // AGENT, WORKFLOW, PLAYBOOK, CAMPAIGN
  category    String   // Sales, Support, Recruiting
  icon        String?
  config      Json     // The JSON config (Workflow structure or Campaign steps)
  metrics     Json?    // e.g. { "avgOpenRate": 0.45, "users": 1000 }
  isOfficial  Boolean  @default(true)
  author      String   @default("ConvoSpan")
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([category])
}

model AgentFeedback {
  id        String   @id @default(uuid())
  messageId String   // The AI message being rated
  userId    String   // Who rated it
  rating    Int      // 1 (bad) or 5 (good), or binary -1/1
  comment   String?  // Optional explanation
  createdAt DateTime @default(now())
  
  message   Message  @relation(fields: [messageId], references: [id])
}

model AgentMemory {
  id        String   @id @default(uuid())
  teamId    String
  key       String   // e.g. "tone_preference", "forbidden_phrase"
  value     String   // e.g. "Always use emojis", "Never mention 'cheap'"
  confidence Float   @default(1.0)
  createdAt DateTime @default(now())
  
  team      Team     @relation(fields: [teamId], references: [id])
  @@index([teamId])
}

model ApiKey {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  scopes      String[] // e.g. ["leads:read", "campaigns:write"]
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  teamId      String
  createdAt   DateTime @default(now())
  
  team        Team     @relation(fields: [teamId], references: [id])
  @@index([teamId])
  @@index([key])
}

model KnowledgeBase {
  id          String          @id @default(uuid())
  name        String
  description String?
  teamId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  team        Team            @relation(fields: [teamId], references: [id])
  items       KnowledgeItem[]
  
  @@index([teamId])
}

model KnowledgeItem {
  id              String        @id @default(uuid())
  content         String        @db.Text
  embedding       Json?         // Stores vector embedding array
  embeddingModel  String?       @default("gemini-1.5-flash")
  version         Int?          @default(1)
  metadata        Json?         // e.g., { source: "URL", type: "PDF", originalName: "pricing.pdf" }
  knowledgeBaseId String
  createdAt       DateTime      @default(now())
  
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  
  @@index([knowledgeBaseId])
}



model CustomDomain {
  id        String   @id @default(uuid())
  domain    String   @unique
  teamId    String
  status    String   @default("pending") // pending, active, invalid
  createdAt DateTime @default(now())
  
  team      Team     @relation(fields: [teamId], references: [id])
  @@index([teamId])
}

model OrganizationPolicy {
  id              String   @id @default(cuid())
  organizationId  String   @unique

  maxDailyActions Int      @default(200)
  maxCampaigns    Int      @default(10)
  maxAgents       Int      @default(5)

  allowInMail     Boolean  @default(false)
  allowScraping   Boolean  @default(false)
  allowUploads    Boolean  @default(true)

  requiresApprovalForCampaign Boolean @default(false)

  // Compliance Settings
  blockedKeywords String[] @default([])
  detectPII       Boolean  @default(false)
  restrictedTone  String?  // aggregated tone constraint

  // Budgeting & Quotas
  maxCreditsPerUser Int      @default(50)
  requiresApprovalForOverage Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [organizationId], references: [id])
}

model UserQuota {
  id              String   @id @default(cuid())
  userId          String
  teamId          String
  monthlyLimit    Int
  currentSpend    Int      @default(0)
  lastReset       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id])
  team            Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model ApprovalRequest {
  id          String   @id @default(uuid())
  teamId      String
  requesterId String
  actionType  String   // "CAMPAIGN_START", "LIMIT_INCREASE"
  entityType  String   // "Campaign"
  entityId    String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  reason      String?  // Why is this requested?
  payload     Json?    // Data needed to execute the action
  
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id])
  requester   User     @relation("requester", fields: [requesterId], references: [id])
  reviewer    User?    @relation("reviewer", fields: [reviewerId], references: [id])

  @@index([teamId])
  @@index([status])
}

model Playbook {
  id          String   @id @default(uuid())
  name        String
  description String?
  teamId      String
  config      Json     // The campaign template (messages, steps)
  parameters  Json?    // e.g. ["companyName", "offer"]
  isLocked    Boolean  @default(false)
  visibility  String   @default("INTERNAL") // INTERNAL, PUBLIC
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id])
  
  @@index([teamId])
}
